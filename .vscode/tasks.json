{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve portfolio",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8000",
                "--bind",
                "127.0.0.1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$"
                },
                "background": {
                    "activeOnStart": true,
                    "endsPattern": "^Serving HTTP on .* port 8000"
                }
            }
        }
    ]
}
